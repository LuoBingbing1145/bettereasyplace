{
	"schemaVersion": 1,
	"id": "bettereasyplace",
	"version": "${version}",
	"name": "BetterEasyPlace",
	"description": "A mod that improves the easy place functionality of Litematica",
	"authors": [
		"LBB285"
	],
	"contact": {
		"sources": "https://github.com/LuoBingbing1145/bettereasyplace",
		"issues": "https://github.com/LuoBingbing1145/bettereasyplace/issues",
		"homepage": "https://modrinth.com/mod/bettereasyplace"
	},
	"license": "MIT",
	"icon": "assets/bettereasyplace/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"me.lbb.bettereasyplace.BetterEasyPlace"
		],
		"client": [
			"me.lbb.bettereasyplace.client.BetterEasyPlaceClient"
		],
		"modmenu": [
			"me.lbb.bettereasyplace.compat.modmenu.ModMenuImpl"
		]
	},
	"mixins": [
		"bettereasyplace.mixins.json",
		{
			"config": "bettereasyplace.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": "*",
		"minecraft": "1.21.11",
		"java": ">=17",
		"litematica": ">=0.26.12",
		"malilib": ">=0.26.0"
	},
	"suggests": {
		"modmenu": "*"
	}
}